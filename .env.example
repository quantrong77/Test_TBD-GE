# Chép thành .env.local khi chạy trên máy (npm run dev / build). Để trống = chế độ dùng một mình (không đăng nhập, không đồng bộ).

# --- Máy chủ Google (Apps Script + Google Sheets/Drive). Xem gas/README.md
# Địa chỉ web app Apps Script (kết thúc bằng /exec)
VITE_GAS_URL=
# OAuth Client ID loại Web application (chỉ Client ID, KHÔNG dùng Client secret)
VITE_GOOGLE_CLIENT_ID=
